# Copy these into Vercel → Project → Settings → Environment Variables.
# None of these values are stored in git.

TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://clippost.vercel.app/api/callback

# 32+ random chars used to encrypt the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string
